{
  "name": "tcl-navigate",
  "displayName": "TCL Navigation and Tools",
  "description": "",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lukemt/tcl-navigate"
  },
  "publisher": "lukemt",
  "engines": {
    "vscode": "^1.57.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:tcl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tcl-navigate.runSelection",
        "title": "Run TCL Selection",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tcl-navigate.runSelection",
          "when": "editorLangId == tcl",
          "group": "navigation@5"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "TCL Navigate",
      "properties": {
        "tcl-navigate.tclTerminalName": {
          "type": "string",
          "default": "tclsh",
          "description": "Name of the terminal used to run TCL commands"
        },
        "tcl-navigate.tclTerminalPath": {
          "type": "string",
          "default": "tclsh",
          "description": "Shell path used when creating the TCL terminal"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.57.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "eslint": "^9.19.0",
    "typescript": "^5.7.3",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}